# Optional: server-side language model (any OpenAI-compatible endpoint serving Qwen3.5-2B).
# Leave LLM_BASE_URL empty to use the approved template and/or in-browser WebGPU mode only.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=qwen3.5-2b
LLM_MAX_TOKENS=380
LLM_TIMEOUT_MS=55000

# Optional: ONNX model used by the in-browser (WebGPU) mode
NEXT_PUBLIC_BROWSER_MODEL_ID=onnx-community/Qwen3.5-2B-ONNX-OPT
